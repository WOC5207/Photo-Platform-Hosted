# dependencies
node_modules/

# next.js
.next/
out/

# local data (uploaded photos + the Postgres volume) — the photos/ folder
# itself is tracked (as an empty placeholder, see data/photos/.gitkeep) so
# Docker's bind mount always has somewhere to mount on a fresh clone; only
# its actual contents are ignored.
#
# data/pg (the Postgres volume) is deliberately NOT tracked, not even a
# .gitkeep: Postgres refuses to initialise into a non-empty data directory,
# so a placeholder file there would break the first `docker compose up` with
# a misleading "directory not empty" error. Docker creates it on demand.
data/*
!data/photos
data/photos/*
!data/photos/.gitkeep

# env files — commit only .env.example
.env
.env.*
!.env.example

# misc
*.log
.DS_Store
next-env.d.ts
*.tsbuildinfo
