# ============================================================
# Photo Platform — environment configuration
# Copy this file to `.env` and fill in every value.
# ============================================================

# --- Database ---------------------------------------------------------
# Password for the bundled Postgres container. Set this before the first
# `docker compose up` — Postgres only reads it when it initialises the data
# directory, so changing it later does NOT change the actual password.
# Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD="change-me-to-a-long-random-password"

# The app's connection string. Inside Docker this is set for you by
# docker-compose.yml and does not belong here. Uncomment only for running
# the app directly on your machine against a local Postgres:
# DATABASE_URL="postgresql://photo:photo@localhost:5432/photo?schema=public"

# --- Storage ----------------------------------------------------------
# Where selected photo masters, pending comparisons and generated sizes live. Inside Docker this
# must stay as below (the mounted /data/photos volume).
PHOTOS_DIR="/data/photos"

# --- Platform admin account (seeded on the very first login) ----------
# These create the FIRST account only, and are never consulted again — the
# database copy wins from then on, and the setup wizard prompts you to replace
# them. Everyone else joins by invite; there is no public signup.
ADMIN_USERNAME="admin"
# Choose a long, unique password. It is stored only as a bcrypt hash.
ADMIN_PASSWORD="change-me-to-a-long-password"

# --- Sessions ---------------------------------------------------------
# At least 32 random characters. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-32-characters-minimum-random-string"

# --- Public URL -------------------------------------------------------
# The public HTTPS address of the site (your DSM reverse-proxy hostname).
# Used to build shareable booking links, visitor cancel links, and the invite
# links you send to photographers — so it must match the domain people land on.
APP_BASE_URL="https://photos.example.com"

# --- Privacy ----------------------------------------------------------
# Displayed images ALWAYS have all EXIF (including GPS) stripped.
# false: photographers may choose a byte-identical Original in the upload queue.
# true: hide Original, requiring an EXIF-free Archive or Balanced stored master.
STRIP_ORIGINAL_EXIF="false"

# --- Uploads ----------------------------------------------------------
# Maximum size of a single uploaded photo, in megabytes. This is per file;
# the per-account storage allowance is set from Admin -> Storage instead.
UPLOAD_MAX_MB="100"
