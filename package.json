{
  "name": "photo-platform",
  "version": "2.0.0",
  "description": "Self-hosted, bilingual multi-tenant photo gallery and photoshoot booking platform.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test:concurrency": "tsx --env-file=.env --conditions=react-server scripts/test-concurrency.ts",
    "test:isolation": "tsx --env-file=.env --conditions=react-server scripts/test-tenant-isolation.ts",
    "test:quota": "tsx --env-file=.env --conditions=react-server scripts/test-quota.ts",
    "test:images": "tsx --conditions=react-server scripts/test-image-compression.ts",
    "test:security": "tsx --conditions=react-server scripts/test-security-remediation.ts",
    "test:security:db": "tsx --env-file=.env --conditions=react-server scripts/test-security-db.ts",
    "test:http": "tsx --env-file=.env --conditions=react-server scripts/test-http-isolation.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "exifr": "^7.1.3",
    "iron-session": "^8.0.4",
    "next": "^15.5.0",
    "next-intl": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.16.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@swc/core@1.15.43": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
