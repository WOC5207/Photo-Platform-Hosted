// MIGRATIONS ARE ADDITIVE FROM HERE ON.
//
// While this fork was being built and nothing was deployed, the single
// 00000000000000_init migration was regenerated from scratch after every schema
// change. That was legitimate only because every database started empty.
//
// Once this has run anywhere real, that stops being true: `prisma migrate
// deploy` replays migrations it has not seen, so rewriting init means asking a
// live database to create tables it already has — the deploy fails, and the
// container restart-loops. Add a new migration instead:
//
//   npx prisma migrate dev --name what_changed
//
// and never edit or regenerate a migration that has been applied.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A person with an account. Replaces the old single AdminUser: the platform
// admin is just a User with role "admin", so there is one identity model
// rather than a privileged special case.
//
// Every content model points back here via ownerId. Nothing is globally
// scoped any more: a query without an owner filter is a cross-tenant read.
model User {
  id           String @id @default(cuid())
  // Doubles as the public URL identity (/u/<username>), so it stays globally
  // unique even once content is scoped per owner.
  username     String @unique
  passwordHash String
  // "user" | "admin". Plain strings to match Booking.status, which is a string
  // because SQLite had no enums; Postgres does, so converting them all is a
  // worthwhile follow-up, but not this phase's business.
  role         String @default("user")
  // "active" | "suspended". Never cached in the session cookie — see
  // getCurrentUser in src/lib/auth.ts for why.
  status       String @default("active")
  // Human-readable name for the directory listing. Empty = fall back to
  // username, so an account is never nameless.
  displayName  String @default("")
  // Optional contact email for platform notifications: booking alerts for this
  // owner's events and admin announcements. Empty = this account gets no email
  // (in-app only), matching the pre-email default. Set by the account holder in
  // Account -> Profile.
  email        String @default("")

  // The tier this account is on. NULL = the default tier, so a new account is
  // on the default without anything having to assign it.
  tierId        String?
  tier          Tier?     @relation(fields: [tierId], references: [id], onDelete: SetNull)
  // When this account's tier assignment lapses. NULL = it does not.
  //
  // Expiry is resolved lazily, at the moment the tier is read, rather than by a
  // scheduled job: there is no scheduler here, and a job would be a second way
  // for the answer to be wrong (missed run, wrong clock) on top of the rule
  // itself. Read-time resolution cannot drift — the account is on the default
  // tier the instant the date passes, whether or not anything ran.
  tierExpiresAt DateTime?

  // Per-account override of the tier's storage allowance, in bytes.
  // NULL = use the tier's, which is the normal case.
  //
  // BigInt because a 32-bit Int caps at ~2.1GB, which is under one photoshoot.
  // The effective allowance is override ?? effective-tier's — expressed once,
  // in SQL, in src/lib/quota.ts, because the upload check has to be a single
  // atomic statement and cannot afford a second opinion computed elsewhere.
  quotaBytes   BigInt?
  // Live running total of everything this account has on disk. A denormalised
  // counter rather than a SUM() because the check has to be atomic: SUM ->
  // compare -> write leaves a window where two concurrent uploads both pass a
  // check they should not. See src/lib/quota.ts.
  //
  // The cost is drift, which reconcileQuota() exists to correct.
  usedBytes    BigInt  @default(0)
  // On-disk bytes held by pending (not yet published) uploads. Tracked apart
  // from usedBytes because pending photos no longer count toward the storage
  // quota — they are compressed in the background and only charged to usedBytes
  // at publish. This counter bounds pending disk so a runaway upload cannot
  // fill the NAS (config.pendingMaxBytes), using the same atomic check-and-claim
  // pattern as usedBytes. reconcileQuota() corrects its drift too.
  pendingBytes BigInt  @default(0)

  createdAt DateTime @default(now())

  // Everything this account owns. Cascade means deleting a User removes all of
  // it in one statement — but NOT their files on disk, which must be removed
  // first and separately (see the storage phase).
  settings       SiteSettings?
  events         Event[]
  bookingEvents  BookingEvent[]
  announcements  Announcement[]
  personalLinks  PersonalLink[]
  creditProfiles CreditProfile[]
  siteImages     SiteImage[]

  invitesIssued Invite[] @relation("InviteIssuer")
  invite        Invite?  @relation("InviteRedeemer")

  notificationTargets    PlatformNotificationTarget[]
  notificationDismissals PlatformNotificationDismissal[]
  moderationDecisions    ModerationDecision[]            @relation("ModerationReviewer")
  weChatIdentities       WeChatIdentity[]
  contentReportsReviewed ContentReport[]                 @relation("ContentReportReviewer")
}

// One uploaded site-level image (logo, background, contact QR, announcement
// picture). The file itself lives at <PHOTOS_DIR>/u/<ownerId>/_site/<token>.webp.
//
// The rows exist for two reasons the filesystem cannot answer: quota has to
// count these bytes, and the public serving route only has a token to go on and
// needs to know whose directory to read from.
//
// The token stays the row's identity rather than the id, because the token is
// already what the URL and the SiteSettings columns carry.
model SiteImage {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  token     String   @unique
  // "bg" | "logo" | "qr" | "announcement" — for the admin storage breakdown.
  purpose   String
  bytes     Int
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// A named storage allowance accounts can be put on, so the admin sets a limit
// in one place instead of typing the same number onto every account.
model Tier {
  id         String   @id @default(cuid())
  // Admin-facing only; never shown on a public page.
  name       String   @unique
  quotaBytes BigInt
  // Exactly one tier is the default: new accounts get it, and an expired
  // assignment falls back to it.
  //
  // "At most one" is enforced by a PARTIAL unique index, added by hand in the
  // migration — Prisma cannot express "unique among the rows where isDefault is
  // true", and a plain @unique here would instead allow only one tier to be
  // NON-default, which is the opposite of the rule. "At least one" is enforced
  // in code: the default tier cannot be deleted or un-defaulted directly, only
  // replaced by promoting another.
  isDefault  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  // SetNull rather than Cascade: deleting a tier must never delete accounts.
  // Deleting one that is in use is blocked in the action anyway; this is the
  // backstop, and NULL already means "on the default tier".
  users User[]
}

// Registration is invite-only: there is no public signup form, so an account
// can only exist because an admin handed out one of these.
model Invite {
  id                   String    @id @default(cuid())
  // Random, unguessable — it is the whole of the /register/<code> URL.
  code                 String    @unique
  issuedById           String
  issuedBy             User      @relation("InviteIssuer", fields: [issuedById], references: [id], onDelete: Cascade)
  // Free-text reminder of who it was meant for; admin-only, never public.
  note                 String    @default("")
  expiresAt            DateTime?
  redeemedAt           DateTime?
  // One account per invite, enforced by the DB rather than by a check —
  // redemption also locks the row, so a shared link cannot be used twice.
  redeemedById         String?   @unique
  redeemedBy           User?     @relation("InviteRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)
  // Populated only when the platform notice required affirmative consent at
  // redemption time. Historical invites remain null rather than implying an
  // agreement that was never collected.
  consentNoticeVersion Int?
  consentNoticeHash    String?
  consentLocale        String?
  consentAcceptedAt    DateTime?
  createdAt            DateTime  @default(now())

  @@index([issuedById])
}

// One platform-wide row controlled by administrators. The registration notice
// appears before the account form for every usable invite link.
model PlatformSettings {
  id                                      String   @id @default("platform")
  registrationNoticeEnabled               Boolean  @default(false)
  registrationNoticeDelaySeconds          Int      @default(5)
  registrationNoticeTitleEn               String   @default("")
  registrationNoticeTitleZh               String   @default("")
  registrationNoticeBodyEn                String   @default("")
  registrationNoticeBodyZh                String   @default("")
  // information | consent. Version increments whenever notice content or mode
  // changes so a registration form cannot accept stale legal text.
  registrationNoticeMode                  String   @default("information")
  registrationNoticeVersion               Int      @default(1)
  // Responsibility notice shown when a photographer opts into displaying
  // prices. Version increments with its content so stale acknowledgements
  // cannot enable the feature.
  bookingPriceNoticeTitleEn               String   @default("")
  bookingPriceNoticeTitleZh               String   @default("")
  bookingPriceNoticeBodyEn                String   @default("")
  bookingPriceNoticeBodyZh                String   @default("")
  bookingPriceNoticeVersion               Int      @default(1)
  // Post-publish image screening. Thresholds are nullable: null means the
  // provider's own binary category decision is the only trigger.
  moderationEnabled                       Boolean  @default(false)
  moderationPolicyVersion                 Int      @default(1)
  moderationThresholdSelfHarm             Float?
  moderationThresholdSelfHarmIntent       Float?
  moderationThresholdSelfHarmInstructions Float?
  moderationThresholdSexual               Float?
  moderationThresholdViolence             Float?
  moderationThresholdViolenceGraphic      Float?
  updatedAt                               DateTime @updatedAt
}

// A gallery event = one photo album (a con, a shoot, etc.)
model Event {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Unique per owner, not globally: two photographers must both be able to
  // have /u/alice/gallery/fanexpo-2025 and /u/bob/gallery/fanexpo-2025.
  slug          String
  titleEn       String
  titleZh       String
  descriptionEn String    @default("")
  descriptionZh String    @default("")
  location      String    @default("")
  dateStart     DateTime?
  dateEnd       DateTime?
  published     Boolean   @default(false)
  coverPhotoId  String?   @unique
  coverPhoto    Photo?    @relation("EventCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  photos        Photo[]   @relation("EventPhotos")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([ownerId, slug])
  @@index([ownerId])
}

model Photo {
  id                      String            @id @default(cuid())
  eventId                 String
  event                   Event             @relation("EventPhotos", fields: [eventId], references: [id], onDelete: Cascade)
  // Final master filename, or the active versioned candidate while pending.
  // Public renditions use the photo id and never expose pending filenames.
  filename                String
  originalName            String
  width                   Int
  height                  Int
  // Total on-disk size of this photo: the original plus all three renditions.
  // Recorded at upload because nothing else knows it — sizing the files later
  // means an fs.stat per photo, which is what the storage page used to do.
  // Int (2GB) is ample for one photo; only the per-user totals need BigInt.
  bytes                   Int               @default(0)
  // Storage choice for new pending uploads: original | archive | balanced.
  // Existing photos default to original and require no filesystem migration.
  storagePreset           String            @default("original")
  // While pending, the exact source and one compressed comparison candidate
  // coexist. These persisted sizes make the queue recoverable after reloads.
  candidatePreset         String?
  sourceFilename          String?
  sourceBytes             Int?
  candidateBytes          Int?
  renditionBytes          Int?
  // One or more (credited person, subject) credits — most photos have one,
  // group shots have several.
  credits                 PhotoCredit[]
  // EXIF read from the uploaded original at upload time (before it's
  // stripped for the displayed renditions). Null when the file had none.
  exifFocalLengthMm       Float?
  exifAperture            Float?
  exifExposureTime        Float?
  exifIso                 Int?
  exifTakenAt             DateTime?
  exifCameraModel         String?
  exifLensModel           String?
  sortOrder               Int               @default(0)
  // A free-text note the photographer can attach to a photo, shown under the
  // credit/subject line on the enlarged photo and included in the homepage
  // search. Independent of PhotoCredit (which is per credited person); a photo
  // has at most one comment. Empty string = none.
  comment                 String            @default("")
  // Non-null while the owner is still building an upload batch. Pending
  // photos are fully processed and count toward storage, but stay private and
  // out of normal photo queries until the batch is finalized with credits.
  pendingBatchId          String?
  // ready | processing | pending | finalizing | deleting. Existing/directly-created photos
  // default to ready; the database check constraint keeps this in sync with
  // pendingBatchId so forgotten query paths fail closed.
  //
  // "processing" now spans the whole background-compression window: POST stores
  // the source and thumbnail (so a preview exists immediately) and leaves the
  // row processing while a background worker generates the remaining renditions
  // and the compressed master, then flips it to "pending".
  uploadState             String            @default("ready")
  // Set while a background worker owns this row's compression. Lets exactly one
  // worker (even across app instances) claim a processing row via
  // FOR UPDATE SKIP LOCKED, and lets the startup sweep reclaim a row whose
  // worker died mid-compress (claim older than config.compressionClaimStaleMs).
  compressionClaimedAt    DateTime?
  // True when background compression failed and the source was kept for retry.
  // Distinguishes a stuck/failed processing row from one still being worked.
  compressionFailed       Boolean           @default(false)
  createdAt               DateTime          @default(now())
  coverOf                 Event?            @relation("EventCover")
  // Admin-picked for the homepage's per-event carousel. Independent of
  // coverPhotoId (which is exactly one photo per event, used for gallery
  // listing thumbnails) — any number of a published event's photos can be
  // marked here, and that's what populates its homepage carousel slides.
  homeHighlight           Boolean           @default(false)
  // Relative visual importance in the homepage's recent-work mosaic. The
  // database chooses 1-5 for every new photo; photographers can later tune it.
  // It does not affect gallery ordering or the separate highlight carousel.
  homeWeight              Int               @default(dbgenerated("(floor(random() * 5) + 1)::integer"))
  // Independent from uploadState: files can be fully finalized while their
  // public visibility is held for a post-publish moderation decision.
  // not_required | queued | processing | approved | review_required |
  // rejected | error
  moderationStatus        String            @default("not_required")
  moderationPolicyVersion Int?
  moderationThresholds    Json?
  moderationClaimedAt     DateTime?
  moderationNextRetryAt   DateTime?
  moderationAttempts      Int               @default(0)
  moderationScans         ModerationScan[]
  moderationReview        ModerationReview?
  contentReports          ContentReport[]

  @@index([eventId, pendingBatchId])
  @@index([moderationStatus, moderationNextRetryAt])
}

// Immutable record of one successful provider response. Failed attempts live
// on Photo's durable job state until a later successful scan or terminal error.
model ModerationScan {
  id                String   @id @default(cuid())
  photoId           String
  photo             Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  requestId         String
  requestedModel    String
  returnedModel     String
  policyVersion     Int
  attempt           Int
  providerFlagged   Boolean
  categories        Json
  categoryScores    Json
  appliedInputTypes Json
  thresholds        Json
  triggerReasons    Json
  startedAt         DateTime
  completedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([photoId, createdAt])
}

// Exists only after a scan requires human review. Safe scans never create a
// queue record, which keeps the platform review surface focused on exceptions.
model ModerationReview {
  id              String               @id @default(cuid())
  photoId         String               @unique
  photo           Photo                @relation(fields: [photoId], references: [id], onDelete: Cascade)
  status          String               @default("open")
  providerFlagged Boolean
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  decisions       ModerationDecision[]

  @@index([status, createdAt])
}

model ModerationDecision {
  id         String           @id @default(cuid())
  reviewId   String
  review     ModerationReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User             @relation("ModerationReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  action     String
  note       String           @default("")
  createdAt  DateTime         @default(now())

  @@index([reviewId, createdAt])
  @@index([reviewerId])
}

// A single credited-person+subject credit on a photo. Shown identically on
// both the zh and en sites (these are names, not translatable content). A
// photo with multiple credited people gets one row per person.
model PhotoCredit {
  id          String       @id @default(cuid())
  photoId     String
  photo       Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)
  creditName  String
  subject     String       @default("")
  sortOrder   Int          @default(0)
  socialLinks SocialLink[]
}

// A credited person's social-media profile link, shown as a button on the
// enlarged photo. A credit can link to several platforms.
model SocialLink {
  id        String      @id @default(cuid())
  creditId  String
  credit    PhotoCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  // Free-text platform label typed by the admin (e.g. "Instagram", "小红书").
  platform  String
  url       String
  sortOrder Int         @default(0)
}

// A remembered social-media profile for a credited person, looked up by
// exact name text. Kept in sync automatically whenever a photo credit is
// saved with social links (see syncCreditProfiles in
// src/lib/photoCredits.ts), so the admin only has to type a person's links
// once — the photo-credit editors prefill new/matching rows from here.
// Independent of PhotoCredit/SocialLink, which remain the actual per-photo
// data that renders on the gallery; this table is never rendered directly,
// only consulted for autofill.
model CreditProfile {
  id          String                    @id @default(cuid())
  ownerId     String
  owner       User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Unique per owner, not globally: this is one photographer's private address
  // book. Two of them can both remember a "Jane", and Alice's links for her
  // must never autofill into Bob's editor.
  creditName  String
  socialLinks CreditProfileSocialLink[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@unique([ownerId, creditName])
  @@index([ownerId])
}

model CreditProfileSocialLink {
  id              String        @id @default(cuid())
  creditProfileId String
  creditProfile   CreditProfile @relation(fields: [creditProfileId], references: [id], onDelete: Cascade)
  platform        String
  url             String
  sortOrder       Int           @default(0)
}

// A bookable photoshoot event with time slots (separate from gallery events)
model BookingEvent {
  id               String       @id @default(cuid())
  ownerId          String
  owner            User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Unguessable token used in the shareable public URL. Stays globally unique:
  // the token alone identifies the event *and* resolves its owner, which is
  // why /book/[token] needs no /u/<username> prefix.
  token            String       @unique
  titleEn          String
  titleZh          String
  descriptionEn    String       @default("")
  descriptionZh    String       @default("")
  location         String       @default("")
  date             DateTime
  open             Boolean      @default(true)
  // Whether holders of a private booking link may update their reservation.
  // The cutoff is measured backwards from the booking's current start time.
  visitorEditsEnabled     Boolean      @default(false)
  visitorEditCutoffHours  Int          @default(24)
  // Whether the prize-draw tool is enabled for this event at all. Off by
  // default so existing/new events don't suddenly expose a "Prize draw"
  // link and public entry page until the admin opts in.
  lotteryEnabled   Boolean      @default(false)
  // Becomes true after the event's first slot batch is added. It keeps the
  // "copy first batch to every day" setup shortcut limited to new schedules.
  slotsInitialized Boolean      @default(false)
  // The days this event spans. A one-day event has a single BookingDay; a
  // multi-day event has one per selected calendar date. `date` above is kept as
  // a denormalized copy of the earliest day (maintained by the booking actions)
  // so list ordering and legacy `date` reads keep working.
  days             BookingDay[]
  slots            TimeSlot[]
  lotteryDraw      LotteryDraw?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([ownerId])
}

// One calendar day of a BookingEvent. Availability (TimeSlots) hangs off a day,
// so the admin sets slots per day and visitors pick a day then a slot. The
// naive-UTC convention matches BookingEvent.date and slot times: midnight UTC
// stands for the wall-clock day, with no timezone conversion.
model BookingDay {
  id             String       @id @default(cuid())
  bookingEventId String
  bookingEvent   BookingEvent @relation(fields: [bookingEventId], references: [id], onDelete: Cascade)
  date           DateTime
  slots          TimeSlot[]
  createdAt      DateTime     @default(now())

  @@unique([bookingEventId, date])
  @@index([bookingEventId])
}

model TimeSlot {
  id             String       @id @default(cuid())
  bookingEventId String
  bookingEvent   BookingEvent @relation(fields: [bookingEventId], references: [id], onDelete: Cascade)
  // The day this slot belongs to. Redundant with bookingEventId (a day belongs
  // to exactly one event) but kept alongside it so event-scoped ownership joins
  // and the FOR UPDATE reserve path stay unchanged.
  bookingDayId   String
  bookingDay     BookingDay   @relation(fields: [bookingDayId], references: [id], onDelete: Cascade)
  startTime      DateTime
  endTime        DateTime
  capacity       Int          @default(1)
  // Display-only price text such as "CAD 50" or "¥200". No payment or total
  // calculation is performed; each booking still reserves one capacity unit.
  pricePerPerson String       @default("")
  // Optional label shown to visitors alongside the time (e.g. which
  // photographer is working that slot, when multiple are onsite the same
  // day). Set once per batch in the admin "add slots" form. Empty = no label.
  descriptionEn  String       @default("")
  descriptionZh  String       @default("")
  bookings       Booking[]
}

// One row per user, holding everything they can customise about their own
// site. Was a singleton (id was always "site") back when the deployment was
// one photographer's portfolio; now each account gets its own row, which is
// what makes per-user homepages, branding and feature toggles possible.
model SiteSettings {
  id                                String    @id @default(cuid())
  ownerId                           String    @unique
  owner                             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  siteTitleEn                       String    @default("")
  siteTitleZh                       String    @default("")
  // Homepage hero headline/subtitle. Empty = use the built-in default copy.
  homeTitleEn                       String    @default("")
  homeTitleZh                       String    @default("")
  homeSubtitleEn                    String    @default("")
  homeSubtitleZh                    String    @default("")
  // Empty = use the contact-sheet canvas. Otherwise a CSS hex like "#0a0a0a".
  backgroundColor                   String    @default("")
  // Optional semantic palette overrides for the photographer's public site.
  // Empty values keep the contact-sheet defaults. Once any surface/text value
  // is set, the remaining empty values fall back to the standard light palette
  // so the public site remains a coherent, contrast-checked color system.
  surfaceColor                      String    @default("")
  fieldColor                        String    @default("")
  textColor                         String    @default("")
  // Public-site accent used for primary actions, active states and focus.
  // Empty = use the platform's safelight accent.
  themeColor                        String    @default("")
  // Independent dark-mode semantic palette. Existing light fields above stay
  // unchanged for backwards compatibility and form the light-mode palette.
  darkBackgroundColor               String    @default("")
  darkSurfaceColor                  String    @default("")
  darkFieldColor                    String    @default("")
  darkTextColor                     String    @default("")
  darkThemeColor                    String    @default("")
  // Empty = no background image. Otherwise a token; file lives at
  // <PHOTOS_DIR>/_site/<token>.webp, served via /api/site/<token>.webp.
  backgroundImage                   String    @default("")
  // Logo shown in the admin header (links to the homepage). Empty = none.
  // Same token/storage scheme as backgroundImage.
  logo                              String    @default("")
  // Vocabulary override for the "credited person" / "subject" concepts used
  // across the photo-credit editor and booking form (e.g. a
  // cosplay-photography operator might set "Cosplayer"/"Character"). Empty =
  // use the built-in generic default copy. The homepage quick-stats label
  // defaults to this term too, unless overridden below.
  creditTermEn                      String    @default("")
  creditTermZh                      String    @default("")
  subjectTermEn                     String    @default("")
  subjectTermZh                     String    @default("")
  // Homepage quick-stats label for the credited-person count, independent
  // from creditTermEn/Zh above (e.g. the credit term shown in the photo
  // editor might be "Cosplayer" while the homepage stat reads "CN" for
  // brevity). Empty = fall back to creditTermEn/Zh (pluralized for English).
  homeCreditsLabelEn                String    @default("")
  homeCreditsLabelZh                String    @default("")
  // Site-wide feature switches. Off hides the feature's nav links and
  // homepage elements and blocks its public routes; admin management pages
  // for existing data stay reachable so nothing already collected is lost.
  bookingEnabled                    Boolean   @default(true)
  // Prices are display-only and opt-in. Enabling requires accepting the
  // current platform-admin notice; stored slot prices remain intact when off.
  bookingPriceEnabled               Boolean   @default(false)
  bookingPriceNoticeAcceptedVersion Int?
  bookingPriceNoticeAcceptedLocale  String?
  bookingPriceNoticeAcceptedAt      DateTime?
  // IANA zone used to decide which booking slots are still in the future.
  // Slot values remain naive wall-clock DateTimes, preserving entered times.
  timeZone                          String    @default("UTC")
  lotteryEnabled                    Boolean   @default(true)
  creditProfilesEnabled             Boolean   @default(true)
  announcementsEnabled              Boolean   @default(true)
  // Explicit, fail-closed opt-in for listing this tenant in the WeChat mini
  // program. Existing and newly-created tenants stay unavailable until an
  // administrator has reviewed their public content and enables this flag.
  miniappEnabled                    Boolean   @default(false)
  // "Contact us" card shown behind a header/footer button on the public
  // site. Off hides the button entirely, site-wide. titleEn/Zh label the
  // card (empty = built-in default copy). The link and QR code are set
  // independently per language — e.g. a WeChat QR for the Chinese site and
  // a WhatsApp link for the English one — so each is empty = no contact
  // method for that language (the button just doesn't render on that
  // locale, even if the other language has one configured). QR image
  // fields use the same token/storage scheme as backgroundImage/logo.
  contactEnabled                    Boolean   @default(false)
  contactTitleEn                    String    @default("")
  contactTitleZh                    String    @default("")
  contactUrlEn                      String    @default("")
  contactUrlZh                      String    @default("")
  contactQrImageEn                  String    @default("")
  contactQrImageZh                  String    @default("")
  // Flips to true once a non-admin account finishes the first-run setup wizard.
  // Platform admins bypass onboarding and configure their site in the dashboard.
  setupCompleted                    Boolean   @default(false)
  updatedAt                         DateTime  @updatedAt
}

// The stable server-side identity behind one mini-program visitor. OpenID is
// scoped by AppID, so the compound key is the only safe login lookup. A future
// explicit account-linking flow may set userId; profile text never links users.
model WeChatIdentity {
  id        String   @id @default(cuid())
  appId     String
  openId    String
  unionId   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       MiniProgramSession[]
  bookings       Booking[]
  lotteryEntries LotteryEntry[]
  contentReports ContentReport[]

  @@unique([appId, openId])
  @@index([unionId])
  @@index([userId])
}

// Only a SHA-256 digest of the opaque 256-bit Bearer token is persisted.
model MiniProgramSession {
  id         String         @id @default(cuid())
  identityId String
  identity   WeChatIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  tokenHash  String         @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())

  @@index([identityId, createdAt])
  @@index([expiresAt])
}

// Visitor reports survive identity deletion for moderation/audit purposes;
// deleting the reporter mapping therefore SET NULLs wechatIdentityId.
model ContentReport {
  id               String          @id @default(cuid())
  photoId          String
  photo            Photo           @relation(fields: [photoId], references: [id], onDelete: Cascade)
  wechatIdentityId String?
  wechatIdentity   WeChatIdentity? @relation(fields: [wechatIdentityId], references: [id], onDelete: SetNull)
  reason           String
  details          String          @default("")
  // pending | reviewing | resolved | dismissed
  status           String          @default("pending")
  reviewedById     String?
  reviewedBy       User?           @relation("ContentReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  resolutionNote   String          @default("")
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([photoId, createdAt])
  @@index([wechatIdentityId])
  @@index([status, createdAt])
}

// Admin-managed links to the photographer's other sites/profiles, shown in
// the homepage sidebar below the quick-stats card.
model PersonalLink {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  labelEn   String
  labelZh   String
  url       String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// Short admin-authored notices shown in the homepage panel's Announcements
// tab (e.g. "Booking for March is now open"). No draft state — like
// PersonalLink, an announcement is live as soon as it's saved.
model Announcement {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  titleEn   String
  titleZh   String
  bodyEn    String   @default("")
  bodyZh    String   @default("")
  // Optional accompanying image, one per announcement (not split by
  // language — same token/storage scheme as backgroundImage/logo, but
  // keyed per-row here instead of the SiteSettings singleton).
  image     String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Booking {
  id               String          @id @default(cuid())
  timeSlotId       String
  timeSlot         TimeSlot        @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  wechatIdentityId String?
  wechatIdentity   WeChatIdentity? @relation(fields: [wechatIdentityId], references: [id], onDelete: SetNull)
  // Visitor's name/handle (shown to the photographer)
  name             String
  // Subject of the shoot (character, role, theme...), optional.
  subject          String          @default("")
  // The visitor's contact info (e.g. their WeChat ID). contactValue is the
  // single free-text field the form now collects. contactMethod is a legacy
  // label snapshot ("WeChat") kept only for bookings made when the form had a
  // separate contact-method dropdown; it is empty for new bookings.
  contactMethod    String          @default("")
  contactValue     String          @default("")
  // Optional email the visitor gives so they get a confirmation and status
  // updates by mail. Separate from contactValue (which is free-form — WeChat,
  // phone, etc.) precisely so we always have a real address to send to. Empty =
  // no email for this booking.
  email            String          @default("")
  notes            String          @default("")
  // Which site language the visitor booked in ("zh" | "en"). Captured so any
  // email we send them — the confirmation now, or a later status change made
  // from the photographer's dashboard (a different session, a different locale)
  // — goes out in *their* language, not whoever triggered it. Defaults to the
  // platform default locale for rows that predate this column.
  locale           String          @default("zh")
  // "confirmed" | "cancelled" (SQLite has no enums)
  status           String          @default("confirmed")
  // Private token for the visitor's self-cancel link
  cancelToken      String          @unique
  createdAt        DateTime        @default(now())
  lotteryEntry     LotteryEntry?

  @@index([wechatIdentityId])
}

// A prize draw ("抽奖") tied to one booking event. Entrants either come from
// the admin hand-picking confirmed bookings, or from visitors filling in the
// shareable public entry link (token). Either way each becomes a
// LotteryEntry with its own display token, so the wheel can show tokens
// instead of names until a winner is revealed.
model LotteryDraw {
  id             String         @id @default(cuid())
  bookingEventId String         @unique
  bookingEvent   BookingEvent   @relation(fields: [bookingEventId], references: [id], onDelete: Cascade)
  // Unguessable token used in the shareable public entry-link URL
  token          String         @unique
  // Whether the public entry link currently accepts new self-entries. Toggled
  // off once the admin wants to lock the pool. Spinning itself is always
  // available while the event's lottery is enabled — there is no separate
  // per-draw spin switch.
  open           Boolean        @default(true)
  entries        LotteryEntry[]
  prizes         LotteryPrize[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// One entrant in a draw: either wrapping a confirmed booking the admin
// selected, or a standalone self-entry a visitor submitted through the
// public link (bookingId null). name/contactValue are always populated on the
// entry itself (copied from the booking at add-time, or typed in directly), so
// display never has to join out to Booking. Once an entry wins a prize,
// wonPrizeId/wonAt are set and it drops out of the pool for later spins.
model LotteryEntry {
  id               String          @id @default(cuid())
  drawId           String
  draw             LotteryDraw     @relation(fields: [drawId], references: [id], onDelete: Cascade)
  bookingId        String?         @unique
  booking          Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  wechatIdentityId String?
  wechatIdentity   WeChatIdentity? @relation(fields: [wechatIdentityId], references: [id], onDelete: SetNull)
  name             String
  subject          String          @default("")
  // Legacy contact-method snapshot from when entries chose a method from a
  // dropdown. Never a foreign key. Both are empty for new entries (which
  // collect only the free-text contactValue); retained so historical entries
  // keep the method they were saved with.
  contactMethodId  String?
  contactMethod    String          @default("")
  contactValue     String          @default("")
  token            String
  wonPrizeId       String?
  wonPrize         LotteryPrize?   @relation(fields: [wonPrizeId], references: [id], onDelete: SetNull)
  wonAt            DateTime?
  createdAt        DateTime        @default(now())
  // One non-null WeChat identity per draw is enforced by the hand-written
  // partial unique index LotteryEntry_drawId_wechatIdentityId_key.

  @@unique([drawId, token])
  @@index([drawId, contactMethodId])
  @@index([wechatIdentityId])
}

// A prize option on the wheel. Remaining stock is derived as quantity minus
// the number of entries linked via wonPrizeId. `weight` is this prize's
// relative chance on the wheel compared to the other in-stock prizes (not a
// percentage — e.g. weight 10 vs weight 1 means ~10x as likely), so slice
// size and odds shrink automatically as prizes with higher weight run out.
model LotteryPrize {
  id        String         @id @default(cuid())
  drawId    String
  draw      LotteryDraw    @relation(fields: [drawId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int            @default(1)
  weight    Int            @default(1)
  sortOrder Int            @default(0)
  winners   LotteryEntry[]
  createdAt DateTime       @default(now())
}

// A message from the platform admin to tenant accounts, shown as a dismissible
// banner across each recipient's /dashboard until that user dismisses it.
//
// Who sees it is resolved at read time (src/lib/platformNotifications.ts):
// audience "all" reaches every account including ones created after sending;
// "selected" reaches exactly the PlatformNotificationTarget rows. Deleting the
// notification retracts it everywhere — there is no editing after send.
model PlatformNotification {
  id             String  @id @default(cuid())
  titleEn        String  @default("")
  titleZh        String  @default("")
  bodyEn         String  @default("")
  bodyZh         String  @default("")
  // Records the administrator's delivery choice, not successful delivery:
  // email remains best-effort and depends on each recipient having an address.
  emailRequested Boolean @default(true)
  // "all" | "selected". Plain string to match the other pseudo-enums here.
  audience       String  @default("all")

  createdAt DateTime @default(now())

  targets    PlatformNotificationTarget[]
  dismissals PlatformNotificationDismissal[]
}

// One selected recipient of a notification with audience "selected".
model PlatformNotificationTarget {
  notificationId String
  notification   PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
}

// One user's dismissal of one notification. DB-backed (not client storage) so
// a dismissal holds across devices, and so the admin can see reach counts.
model PlatformNotificationDismissal {
  notificationId String
  notification   PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime             @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}
